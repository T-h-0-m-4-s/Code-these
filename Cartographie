    Liste_logs.append(f"{(end-start):.2f}")
    print(Liste_logs)

    df1 = pd.DataFrame( [Liste_logs], index=[Nom_fichier_carte], columns=[ "Commune sans patients", "Traj conservés", "Traj pa-pr", "Traj pr-of", "Traj pa-of", "Tps moy pa-pr (min)", "Tps moy pr-of (min)", "Tps moy pa-of (min)", "Tps d'exécution (s)" ] )

