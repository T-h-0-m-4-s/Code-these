            f"{DICTIONNAIRE_DES_TRAJETS_UNIQUES[item][1]} trajets intra-communaux ont été supprimés, "
            f"soit {DICTIONNAIRE_DES_TRAJETS_UNIQUES[item][2]} patients écartés" )

