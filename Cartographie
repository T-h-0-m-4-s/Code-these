    LISTE_TRIPLETS_FLUX, NOMBRE_PARCOURS_SUPPRIMES, NOMBRE_PATIENTS_ECARTES = Re-cherche_donnees_communes_manquantes( LISTE_TRIPLETS_FLUX, ENSEMBLE_COMMUNES_MANQUANTES )

