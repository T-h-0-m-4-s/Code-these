    DICTIONNAIRE_COMMUNES_DISTANCE_TEMPS = Lecture_fichier_Distance_Temps(Config)

    COULEURS_TRAJETS = { "le patient et le prescripteur": "blue", "le prescripteur et l'officine": "red",
