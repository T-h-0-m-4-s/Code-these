    """
    dictionnaire_couleur_trajet = { "darkgreen": ["#004000", "#00ff00"], "red": ["#800000", "#ff0000"], "blue": ["#000080", "#00bfff"] }

    fg = folium.FeatureGroup(name=f"Trajets {nom}", show=False)
