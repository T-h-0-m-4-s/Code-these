    LISTE_SECTEURS_PERSONNELS, DICTIONNAIRE_CENTRE_SECTEURS, DICTION-NAIRE_COMMUNES_SECTEUR, \
    LISTE_TRIPLETS_FLUX, COMMUNES_SANS_PATIENTS, CHOIX_SECTEUR = fond_de_carte( Config, LISTE_SECTEURS_PERSONNELS, DICTIONNAIRE_COULEURS, DICTIONNAIRE_SECTEURS, DICTION-NAIRE_PARCOURS )

